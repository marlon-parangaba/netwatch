# ============================================
# NetWatch - Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores
# ============================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=netwatch
POSTGRES_USER=netwatch
POSTGRES_PASSWORD=netwatch_secret
POSTGRES_SSLMODE=disable

# --- API ---
API_PORT=8080
API_ENV=development
# development | production

# --- JWT ---
JWT_SECRET=troque_este_secret_por_uma_string_longa_e_aleatoria
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_HOURS=168

# --- SNMP Traps ---
SNMP_TRAP_PORT=162
SNMP_COMMUNITY=public

# --- Logging ---
LOG_LEVEL=info
# debug | info | warn | error
LOG_FILE=/app/logs/netwatch.log

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,app://netwatch

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
